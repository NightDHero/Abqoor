NODE_ENV=development
PORT=4000
# Production: https://abqoor-web.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Development can use a relative local path.
# Production on Render must use the mounted persistent disk, for example:
# DATABASE_PATH=/var/data/abqoor.sqlite
DATABASE_PATH=./data/abqoor.sqlite
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=abqoor_session
# Development can use lax. Production Vercel -> Render cookies require none.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
ADMIN_EMAILS=admin@example.com
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
PDFTOPPM_PATH=
# Development: local
# Production: r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional and currently unused while R2 remains private/API-served.
R2_PUBLIC_BASE_URL=
QUESTION_IMAGE_WEBP_QUALITY=88
