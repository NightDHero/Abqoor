NODE_ENV=development
PORT=4000
# Production: https://abqoor-web.vercel.app
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Production: postgres with DATABASE_URL from Supabase/Supavisor.
# Local development default: sqlite.
DATABASE_DRIVER=sqlite
DATABASE_URL=
DATABASE_PATH=./data/abqoor.sqlite
DATABASE_POOL_MAX=3
DATABASE_SSL=true
# Optional PEM CA bundle when the database provider does not use a public CA.
DATABASE_CA_CERT=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=abqoor-api
JWT_AUDIENCE=abqoor-web
SESSION_ABSOLUTE_TTL_MINUTES=10080
SESSION_IDLE_TTL_MINUTES=720
SESSION_COOKIE_NAME=abqoor_session
# Development can use lax. Production Vercel -> Render cookies require none.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
ADMIN_EMAILS=admin@example.com
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Required in production for registration verification and password recovery.
PASSWORD_RESET_URL_BASE=http://localhost:5173
TRANSACTIONAL_EMAIL_FROM=
# Backward-compatible alias for TRANSACTIONAL_EMAIL_FROM.
PASSWORD_RESET_EMAIL_FROM=
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
RESEND_API_KEY=
# Google OAuth 2.0 Web client ID. Use the same client ID in VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Twilio Verify provides real SMS ownership verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PDFTOPPM_PATH=
# Development: local
# Production: r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional and currently unused while R2 remains private/API-served.
R2_PUBLIC_BASE_URL=
QUESTION_IMAGE_WEBP_QUALITY=88
